
# Operation Types (Query, Mutation, Subscription)

type Query {
  books: [Book!]!
  book(id: ID!): Book
}

type Mutation {
  addBook(bookInput: BookInput) : Book!
}

# Object Types (output types)

type Book {
  id: Int!
  title: String!
  author: Author
}

type Author {
  id: Int!
  name: String!
  books: [Book!]!
}

# Input Types

input BookInput {
  title: String!
  authorId: Int!
}
